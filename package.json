{
  "name": "ip3-consulting-site",
  "version": "3.0.0",
  "private": true,
  "description": "IP3 Consulting Limited — static website (generated HTML, GSAP + Lenis motion).",
  "scripts": {
    "build": "node build/build-all.js",
    "dev": "node build/build-all.js && node dev-server.js",
