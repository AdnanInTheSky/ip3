{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about.html",
        "http://localhost/contact.html",
        "http://localhost/privacy.html",
        "http://localhost/terms.html",
        "http://localhost/explore.html",
        "http://localhost/explore/economics-trade.html",
        "http://localhost/explore/finance-investment.html",
        "http://localhost/explore/market-enterprise.html",
        "http://localhost/explore/development-impact.html",
        "http://localhost/explore/policy-governance.html",
        "http://localhost/explore/management-delivery.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 812,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "chromeFlags": "--no-sandbox"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.7
          }
        ]
      }
    }
  }
}
